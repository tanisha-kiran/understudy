{
  "name": "the-understudy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web -c lime,cyan \"npm:server\" \"npm:web\"",
    "server": "node --env-file-if-exists=.env server/index.mjs",
    "web": "vite",
    "demo": "node --env-file-if-exists=.env server/demo.mjs",
    "smoke": "node server/smoke.mjs",
    "build": "tsc --noEmit && vite build",
    "postinstall": "echo \"Run 'npx playwright install chromium' once for the runner.\""
  },
  "dependencies": {
    "express": "^4.19.2",
    "lucide-react": "^0.460.0",
    "openai": "^4.70.0",
    "playwright": "^1.48.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
