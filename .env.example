# Copy to .env (never commit .env). Read server-side only.
OPENAI_API_KEY=
OPENAI_MODEL=
PORT=8787
VITE_PORT=5173
# Keep this port aligned with PORT above.
UNDERSTUDY_SERVER_URL=http://localhost:8787
UNDERSTUDY_DB=data/understudy.sqlite
